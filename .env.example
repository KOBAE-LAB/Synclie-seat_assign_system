# Synclie 座席抽選 環境変数サンプル
# このファイルを .env.local（開発）または /etc/synclie-seat-assign.env（本番）にコピーして値を設定してください。
# 実際のキーやシークレットは絶対にコミットしないこと。

# SQLite データベースファイルのパス（ディレクトリは自動作成されます）
SEAT_ASSIGN_DB_PATH=./data/seat-assign.db

# セッション Cookie 署名用シークレット（32 文字以上のランダム文字列）
# 生成例: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# 教員メッセージの英訳に使う OpenAI API キー（サーバー側のみで使用）
OPENAI_API_KEY=sk-your-key-here
